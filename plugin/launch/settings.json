{
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "20000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80"
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/Cargo.lock)",
      "Read(**/go.sum)",
      "Read(**/poetry.lock)",
      "Read(**/Gemfile.lock)",
      "Read(**/composer.lock)",
      "Read(**/dist/**)",
      "Read(**/target/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/__pycache__/**)"
    ]
  }
}
